# RareEmber storefront -- environment template
# Copy to .env.local and fill in. NEVER commit a real value.
# This file must be committed: the app and the admin panel point operators here.

# ---- Public (safe to expose in the browser) ----
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-key...

# ---- Supabase server-side (NEVER expose) ----
# REQUIRED. Order, payment and fulfilment code uses this key exclusively.
# Without it the storefront returns 503: the public anon key cannot read the
# `orders` table under RLS, and it must never be allowed to write one.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# ---- Razorpay ----
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# ---- Ops auth (rotate these: they were committed in git history) ----
ADMIN_SECRET=generate-a-long-random-value
CRON_SECRET=generate-a-different-long-random-value

# ---- Qikink (print-on-demand factory) ----
QIKINK_CLIENT_ID=...
QIKINK_CLIENT_SECRET=...
QIKINK_API_URL=https://api.qikink.com
QIKINK_SANDBOX=true
# Set to true to hold COD parcels until the customer confirms the address.
COD_CONFIRM_REQUIRED=false

# ---- Notifications ----
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...
TELEGRAM_ALERTS_ENABLED=true
# ---- Email (Resend) ----
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Rare Ember <support@rareember.shop>
RESEND_OWNER_EMAIL=support@rareember.shop

# ---- Security & Cryptographic Tokens ----
STORE_CREDIT_SECRET=generate-a-random-32-byte-hex-string
COD_OTP_SECRET=generate-a-random-32-byte-hex-string


# ---- Optional ----
GEMINI_API_KEY=...
CJ_API_TOKEN=...
CJ_WEBHOOK_SECRET=...

# ---- AI MANAGER AGENT (Hermes Ops) ----
# Reads store data with SUPABASE_SERVICE_ROLE_KEY (already required above).
# Deep analysis LLM: Google Gemini first (any Google AI Studio key),
# automatic OpenRouter fallback if GEMINI unavailable.
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.8-flash
# Secret Telegram verifies on every webhook call (any long random string).
# Then point the bot at the site once:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://www.rareember.shop/api/agent/telegram&secret_token=<SAME_SECRET>"
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-32-char-value
# Telegram reports work with the TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID above;
# TELEGRAM_AGENT_ENABLED=false turns the agent's reports off without touching order alerts.
TELEGRAM_AGENT_ENABLED=true
