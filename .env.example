# RareEmber repo-root environment -- Python engines and ops tooling.
# Copy to .env and fill in. NEVER commit a real value.

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# ---- Site ----
SITE_URL=https://www.rareember.shop
SUPPORT_EMAIL=

# ---- Supabase direct Postgres (ops scripts only) ----
# The password below was committed in git history. ROTATE IT.
SUPABASE_DB_HOST=db.YOUR-PROJECT.supabase.co
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASS=
SUPABASE_DB_NAME=postgres

# ---- Razorpay ----
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Storefront public values (shared with the Next app) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Qikink ----
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
QIKINK_SANDBOX=true
QIKINK_API_URL=https://api.qikink.com

# ---- Admin / content ----
ADMIN_SECRET=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ---- Social automation (sensitive) ----
GH_PAT=
IG_USERNAME=
IG_PASSWORD=
IG_SESSIONID=